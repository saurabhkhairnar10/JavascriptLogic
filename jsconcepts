closure - 
function enclosed with its lexical scope bundled to gether to form a closure.

e.g.1

let createCounter = ()=>{
    let count = 0;//private variable

    function inner(){
        // outside count value can be accessed via inner fun
        count++;
        return count;
    }

}

let counter = createCounter();

console.log(counter());
console.log(counter());
// count can not be accessible

console.log(createCounter()())
